# Generated by Cargo
# will have compiled files and executables
debug
target

# Claude Code harness runtime files (only .claude/skills/**/SKILL.md is tracked)
.claude/*.lock

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
.pytest_cache/

# C / C++ / Java build artifacts
*.o
*.a
*.class
pqid/c/test_pqid
pqid/c/bench_pqid
pqid/c/fuzz_decode
pqhash/c/test_pqhash
pqcrypt/c/test_pqcrypt
pqcrypt/c/bench_pqcrypt
common/c/test_common
tools/conformance/c/conformance_runner
tools/conformance/c/pqcrypt_runner
tools/conformance/go/conformance_runner
tools/conformance/go/pqcrypt_runner/pqcrypt_runner
pqcrypt/cpp/test_pqcrypt

# Go workspace lockfile
go.work.sum

# macOS debug bundles
*.dSYM/
pqid/cpp/test_pqid
pqid/cpp/bench_pqid
pqid/cpp/conformance_runner
pqhash/cpp/test_pqhash
tools/conformance/cpp/conformance_runner
pqid/java/build/
pqhash/java/build/
pqhash/java/build-common/
tools/conformance/java/build/

# Cargo lockfile (library — committing is optional; keep untracked for now)
pqid/rust/Cargo.lock
pqhash/rust/Cargo.lock
tools/conformance/rust/Cargo.lock
Cargo.lock

# Cargo target dirs (workspace target/ now lives at repo root)
target/
pqid/rust/target/
pqhash/rust/target/
# Go pqcrypt_runner build output (rebuilt by tools/conformance/run.sh; the
# pattern `target/` does not match `target-go/` — gitignore matches whole
# path components, so list it explicitly).
target-go/
tools/conformance/rust/target/

# Node / TypeScript
node_modules/
dist/

# LaTeX intermediates
*.aux
*.log
*.toc
*.bbl
*.blg
*.out
*.fdb_latexmk
*.fls
*.synctex.gz

# Root-level whitepaper PDFs: only PQID is a tracked published artifact at the
# repo root (per CLAUDE.md authority order). The canonical PQCrypt / PQHash /
# PQToolkit PDFs live in their own latex/ dirs; the root copies are transient
# build byproducts.
/PQCrypt_Whitepaper.pdf
/PQHash_Whitepaper.pdf
/PQToolkit_Whitepaper.pdf

# OS
.DS_Store

# Conformance harness build artifacts
pqid/conformance/.build/

# Misc local artifacts
/tmp/pqid_*

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
