# Generated by Cargo
# will have compiled files and executables
debug
target

# Claude Code harness runtime files (only .claude/skills/**/SKILL.md is tracked)
.claude/*.lock

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
.pytest_cache/

# C / C++ / Java build artifacts
*.o
*.a
*.class
tessera-id/c/test_tessera_id
tessera-id/c/bench_tessera_id
tessera-id/c/fuzz_decode
tessera-hash/c/test_tessera_hash
tessera-seal/c/test_tessera_seal
tessera-seal/c/bench_tessera_seal
common/c/test_common
tools/conformance/c/conformance_runner
tools/conformance/c/tessera_seal_runner
tools/conformance/go/conformance_runner
tools/conformance/go/tessera_seal_runner/tessera_seal_runner
tessera-seal/cpp/test_tessera_seal

# Go workspace lockfile
go.work.sum

# macOS debug bundles
*.dSYM/
tessera-id/cpp/test_tessera_id
tessera-id/cpp/bench_tessera_id
tessera-id/cpp/conformance_runner
tessera-hash/cpp/test_tessera_hash
tools/conformance/cpp/conformance_runner
tessera-id/java/build/
tessera-hash/java/build/
tessera-hash/java/build-common/
tools/conformance/java/build/

# Cargo lockfiles are COMMITTED (TP-104, supply-chain reproducibility):
# - root Cargo.lock is the one cargo actually consults for every workspace
#   build (rust.yml gates on --locked against it);
# - per-crate tessera-{id,hash,seal}/rust/Cargo.lock document standalone
#   resolution for consumers who vendor a single crate out of the monorepo
#   (cargo ignores nested member lockfiles inside the workspace).

# Cargo target dirs (workspace target/ now lives at repo root)
target/
tessera-id/rust/target/
tessera-hash/rust/target/
# Go tessera_seal_runner build output (rebuilt by tools/conformance/run.sh; the
# pattern `target/` does not match `target-go/` — gitignore matches whole
# path components, so list it explicitly).
target-go/
tools/conformance/rust/target/

# Node / TypeScript
node_modules/
dist/

# LaTeX intermediates
*.aux
*.log
*.toc
*.bbl
*.blg
*.out
*.fdb_latexmk
*.fls
*.synctex.gz

# Root-level whitepaper PDFs: only TesseraID is a tracked published artifact at the
# repo root (per CLAUDE.md authority order). The canonical TesseraSeal / TesseraHash /
# Tessera PDFs live in their own latex/ dirs; the root copies are transient
# build byproducts.
/TesseraSeal_Whitepaper.pdf
/TesseraHash_Whitepaper.pdf
/Tessera_Whitepaper.pdf

# OS
.DS_Store

# Conformance harness build artifacts
tessera-id/conformance/.build/

# Misc local artifacts
/tmp/tessera_id_*

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Go tessera_seal_runner local build output (run.sh builds to target-go/)
tools/conformance/go/tessera_seal_runner/tesseraseal_runner

# generated pkg-config files (templates .pc.in are tracked)
*/c/*.pc
common/c/*.pc
