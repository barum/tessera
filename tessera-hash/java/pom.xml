<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!--
  TesseraHash Java reference implementation - minimal Maven packaging (TESS-00014).

  The Makefile in this directory remains the primary documented build path
  (`make test`); this POM exists so `mvn package` produces a consumable jar.
  com.tessera.common.Keccak from ../../common/java/ is compiled into this jar
  via build-helper (matching the Makefile, which builds the shared source
  directly - never re-vendor Keccak inside the project).
  Publication to Maven Central is gated on the name-clearance decision
  (docs/decisions/2026-06-10-name-clearance.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.tessera</groupId>
  <artifactId>tessera-hash</artifactId>
  <version>1.3.1</version>
  <packaging>jar</packaging>

  <name>TesseraHash</name>
  <description>TesseraHash: 73-byte SHAKE-256 content hash format - Java reference implementation</description>
  <url>https://github.com/barum/tessera</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/barum/tessera</url>
    <connection>scm:git:https://github.com/barum/tessera.git</connection>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Floor: plain Java SE; CI tests JDK 17 and 21. -->
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-common-java-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../../common/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
