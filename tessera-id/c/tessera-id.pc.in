# SPDX-License-Identifier: Apache-2.0
# pkg-config template for the TesseraID C reference implementation.
# @PREFIX@ and @VERSION@ are substituted by `make tessera-id.pc` (see Makefile).
prefix=@PREFIX@
includedir=${prefix}/include/tessera
libdir=${prefix}/lib

Name: tessera-id
Description: TesseraID 41-byte sortable identifier (Standard + HLC) - C reference implementation
URL: https://github.com/barum/tessera
Version: @VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -ltessera_id
